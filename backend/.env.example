# Non-sensitive config only — NO API keys in this file.
# Copy to ~/.secrets/ask-the-early-church.env
#
# This file documents EVERY environment variable the backend reads. Secret
# values (the *_API_KEY vars) are listed by name only — they belong in the
# macOS Keychain locally, or in your platform's secret store in production.
#
# API keys belong in macOS Keychain (run yourself in Terminal):
#   cd backend && bash store_keys_in_keychain.sh

# ── Secrets (names only — set these in Keychain / platform secrets) ──────────
# VOYAGE_API_KEY   — required for semantic (vector) search
# GEMINI_API_KEY   — primary query parser (Gemini 2.5 Flash)
# GROQ_API_KEY     — fallback query parser (Llama 3.3 70B)
# Without these the app still runs: search falls back to raw-keyword FTS.

# ── Models ───────────────────────────────────────────────────────────────────
# VOYAGE_MODEL=voyage-3      # must match the model the corpus was embedded with

# ── CORS ─────────────────────────────────────────────────────────────────────
# Local dev (optional — defaults to http://localhost:5173):
ALLOWED_ORIGIN=http://localhost:5173

# ── Production (set PRODUCTION=1 when running gunicorn) ───────────────────────
# PRODUCTION=1
# ALLOWED_ORIGIN=https://your-frontend-domain.com   # REQUIRED when PRODUCTION=1
# RATELIMIT_STORAGE_URI=redis://your-redis-host:6379 # shared limits across workers
# PORT=5001                                          # injected by Render/ECS

# ── Database hydration (prestart.sh) ─────────────────────────────────────────
# DB_URL=s3://bucket/database.db  # fetched via boto3 using the instance's
#                                  # IAM role (App Runner) — no keys needed here
# DB_FILE=database.db  # local filename (default: database.db)

# ── Serve the built frontend from Flask (optional) ───────────────────────────
# Auto-enabled when a build exists at ../dist. Override the location with:
# FRONTEND_DIST=/absolute/path/to/dist

# ── Optional cache tuning (defaults are fine for local dev) ──────────────────
# SEARCH_CACHE_TTL_SEC=3600
# EMBED_CACHE_SIZE=1024
# PARSE_CACHE_SIZE=512
# HYBRID_CACHE_SIZE=512
# FTS_CACHE_SIZE=512

# Build output
dist/

# Vite temp config artifacts
vite.config.js.timestamp-*.mjs

# Dependencies
node_modules/
backend/.venv/

# Environment variables (keep secrets out of git)
backend/.env
.env
*.env
!backend/.env.example
**/.secrets/

# SQLite corpus + backups — the 663MB database.db lives in R2 (fetched on boot
# by prestart.sh), never in git. *.db covers backend/database.db too.
*.db
*.db-shm
*.db-wal
*.backup.*.db

# OS junk
.DS_Store
Thumbs.db
.fuse_hidden*

# Python cache
__pycache__/
*.pyc
*.pyo

# Corpus tool artifacts
tools/corpus/audit*
tools/corpus/sources/*.pdf
*.log
backend/audit*

# Editor / AI tooling (not part of the app)
.vscode/
.cursor/*
!.cursor/rules/
!.cursor/rules/**
.idea/
.claude/
CURSOR_PROMPT*.md
CLAUDE_CODE_PLAN.md
.cursor/plans/
